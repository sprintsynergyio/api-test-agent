{
  "name": "local-shop-probes",
  "baseUrl": "http://localhost:4000",
  "defaultHeaders": {
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
  "auth": {
    "header": "Authorization",
    "valueEnv": "LOCAL_API_AUTH_VALUE"
  },
  "testCases": {
    "file": "local-shop-probes-test-cases.csv",
    "mode": "sheet-only"
  },
  "endpoints": [
    {
      "id": "list-products",
      "method": "GET",
      "path": "/products",
      "requiresAuth": false,
      "responseSchema": {
        "status": 200,
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "price": {
                "type": "number"
              },
              "category": {
                "type": "string"
              },
              "inStock": {
                "type": "boolean"
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "price",
              "category",
              "inStock",
              "createdAt"
            ]
          }
        }
      }
    },
    {
      "id": "get-product",
      "method": "GET",
      "path": "/products/{id}",
      "requiresAuth": false,
      "responseSchema": {
        "status": 200,
        "schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "price": {
              "type": "number"
            },
            "category": {
              "type": "string"
            },
            "inStock": {
              "type": "boolean"
            },
            "createdAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "price",
            "category",
            "inStock",
            "createdAt"
          ]
        }
      },
      "pathParams": {
        "id": "999999"
      }
    },
    {
      "id": "maintenance",
      "method": "GET",
      "path": "/maintenance",
      "requiresAuth": false
    },
    {
      "id": "create-product",
      "method": "POST",
      "path": "/products",
      "requiresAuth": true,
      "body": {
        "name": "Trail Runner Shoe",
        "price": 89.99,
        "category": "shoes",
        "inStock": true
      }
    },
    {
      "id": "update-product",
      "method": "PUT",
      "path": "/products/{id}",
      "requiresAuth": true,
      "body": {
        "name": "Trail Runner Shoe V2",
        "price": 99.5,
        "category": "shoes",
        "inStock": false
      },
      "setup": {
        "endpointId": "create-product",
        "idField": "id"
      }
    },
    {
      "id": "delete-product",
      "method": "DELETE",
      "path": "/products/{id}",
      "requiresAuth": true,
      "setup": {
        "endpointId": "create-product",
        "idField": "id"
      }
    }
  ]
}
