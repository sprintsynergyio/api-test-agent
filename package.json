{
  "name": "api-test-agent",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test:template": "playwright test -c playwright.config.ts",
    "test:generated": "playwright test -c playwright.generated.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "api:local": "node local-api/server.mjs",
    "api:local:fixed": "FIXED=1 node local-api/server.mjs",
    "probe": "tsx agent/probe.ts",
    "agent": "tsx agent/cli.ts",
    "ui": "node ui/server.mjs",
    "allure": "allure open reports/allure-report",
    "import": "tsx agent/import.ts",
    "test:importers": "tsx agent/importers/importers.test.ts",
    "test:safety": "tsx agent/safety.test.ts",
    "test:redact": "tsx agent/redact.test.ts",
    "test:cleanup": "tsx agent/cleanup.test.ts",
    "test:gate": "tsx agent/validate.test.ts",
    "test:config": "tsx agent/config.test.ts",
    "test:gate:pactum": "tsx agent/frameworks/pactum.test.ts",
    "test:template:pactum": "mocha --config .mocharc.pactum.json tests-pactum/template/*.spec.ts",
    "test:generated:pactum": "mocha --config .mocharc.pactum.json 'generated/**/*.spec.ts'",
    "test:eval": "tsx agent/eval/eval.test.ts",
    "eval": "tsx agent/eval/run.ts",
    "test:claude-api": "tsx agent/claude-api.test.ts",
    "ui:hash": "node ui/hash-password.mjs",
    "check:contract": "tsx agent/check-contract.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "allure": "3.21.0",
    "allure-js-commons": "3.13.0",
    "allure-playwright": "3.13.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.8",
    "mocha": "^12.0.3",
    "pactum": "^3.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
