{
  "openapi": "3.1.0",
  "info": { "title": "Relative Server", "version": "1.0", "description": "OpenAPI 3.1 with a relative server URL and other edge cases. Test fixture." },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/vnd.api+json": { "schema": { "$ref": "#/components/schemas/Order" } } }
        },
        "responses": { "201": { "description": "created" } }
      },
      "get": {
        "operationId": "listOrders",
        "parameters": [{ "name": "X-API-Key", "in": "header", "schema": { "type": "string" }, "example": "importer-secret-test-value" }],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/orders/{orderId}": {
      "patch": {
        "operationId": "patchOrder",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "https://schemas.example.com/order-patch.json" } } }
        },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/reports": {
      "post": {
        "operationId": "createReport",
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object", "properties": { "title": { "type": "string" } } } } }
        },
        "responses": { "201": { "description": "created" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "sid" } },
    "schemas": {
      "Order": {
        "type": "object",
        "required": ["sku", "quantity"],
        "properties": {
          "sku": { "type": "string" },
          "quantity": { "type": "integer" },
          "note": { "type": ["string", "null"] }
        }
      }
    }
  }
}
