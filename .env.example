API_AUTH_VALUE=
LOCAL_API_AUTH_VALUE=
# Login auth demo (input/local-shop-login.json): users of the local fake shop API, nothing real.
LOCAL_API_ADMIN_USER=admin
LOCAL_API_ADMIN_PASSWORD=admin-pass
LOCAL_API_VIEWER_USER=viewer
LOCAL_API_VIEWER_PASSWORD=viewer-pass
# OAuth2 client credentials demo (input/local-shop-oauth.json): the local fake shop API's token endpoint.
LOCAL_API_CLIENT_ID=shop-client
LOCAL_API_CLIENT_SECRET=shop-client-secret
MAX_CLAUDE_CALLS=

# Model provider. The UI's setup card writes these three lines for you (local machines only).
# LLM_PROVIDER: anthropic (default) or openai. LLM_MODEL: optional model id (defaults:
# claude-sonnet-5-5, gpt-6.1-sol). CLAUDE_MODEL still works as the old name of the Anthropic model.
LLM_PROVIDER=
LLM_MODEL=
CLAUDE_MODEL=
# Claude through the Messages API instead of the Claude Code CLI login (required in hosted mode).
# Billed to the key's Console workspace.
ANTHROPIC_API_KEY=
# OpenAI through Chat Completions (with LLM_PROVIDER=openai).
OPENAI_API_KEY=

# Hosted mode (shared server). See docs/HOSTING.md. Leave all of these empty for the local demo.
HOSTED=
HOST=
UI_PORT=
UI_USERS=
HOSTED_RUNS_PER_HOUR=
HOSTED_QUEUE=
HOSTED_RUN_TTL_HOURS=
